generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  CASHIER
}

model User {
  id                    String      @id @default(cuid())
  username              String      @unique
  role                  UserRole
  passwordHash          String
  passwordVersion       Int         @default(1)
  isActive              Boolean     @default(true)
  lastCredentialChangeAt DateTime   @default(now())
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  loginAudits           LoginAudit[]
}

model LoginAudit {
  id         String   @id @default(cuid())
  userId     String
  loginAt    DateTime @default(now())
  isOffline  Boolean  @default(false)
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loginAt])
}

enum InventoryMutationType {
  SALES_OUT
  STOCK_IN
  STOCK_ADJUSTMENT
}

enum InventoryMutationUnit {
  SMALL
  LARGE
}

enum PosPaymentMethod {
  CASH
  BANK_TRANSFER
}

model InventoryMutationEvent {
  id_queue         String                @id
  id_transaksi     String
  id_produk        String
  id_user          String
  jenis_mutasi     InventoryMutationType
  unit_mutasi      InventoryMutationUnit @default(SMALL)
  delta_qty        Int
  logical_clock    Int
  client_timestamp DateTime
  createdAt        DateTime              @default(now())

  @@index([id_produk, client_timestamp])
  @@index([id_user, client_timestamp])
}

model Product {
  id_produk       String   @id @default(cuid())
  nama_produk     String
  sku             String?  @unique
  harga_jual      Int
  harga_jual_unit_besar Int?
  stok_saat_ini   Int      @default(0)
  stok_unit_besar_saat_ini Int @default(0)
  is_active       Boolean  @default(true)
  unit_small_name String   @default("pcs")
  unit_large_name String?
  unit_large_to_small Int?
  allow_buy_in_small  Boolean @default(true)
  allow_buy_in_large  Boolean @default(false)
  allow_sell_in_small Boolean @default(true)
  allow_sell_in_large Boolean @default(false)
  last_synced_at  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([nama_produk])
  @@index([is_active])
}

model PosTransaction {
  id_transaksi      String           @id
  short_id          String           @unique
  kasir_user_id     String
  kasir_username    String
  payment_method    PosPaymentMethod
  subtotal_amount   Int
  item_discount     Int @default(0)
  order_discount    Int @default(0)
  total_amount      Int
  amount_received   Int?
  change_amount     Int?
  counts_for_cash   Boolean          @default(true)
  note              String?
  client_timestamp  DateTime
  createdAt         DateTime         @default(now())
  lines             PosTransactionLine[]

  @@index([client_timestamp])
  @@index([payment_method, client_timestamp])
}

model PosTransactionLine {
  id                 String         @id @default(cuid())
  id_transaksi       String
  id_produk          String
  nama_produk        String
  unit_price         Int
  qty                Float
  line_discount      Int @default(0)
  line_total         Int
  createdAt          DateTime @default(now())
  transaction        PosTransaction @relation(fields: [id_transaksi], references: [id_transaksi], onDelete: Cascade)

  @@index([id_transaksi])
}
