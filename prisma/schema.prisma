generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  CASHIER
}

model User {
  id                    String      @id @default(cuid())
  username              String      @unique
  role                  UserRole
  passwordHash          String
  passwordVersion       Int         @default(1)
  isActive              Boolean     @default(true)
  lastCredentialChangeAt DateTime   @default(now())
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  loginAudits           LoginAudit[]
}

model LoginAudit {
  id         String   @id @default(cuid())
  userId     String
  loginAt    DateTime @default(now())
  isOffline  Boolean  @default(false)
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loginAt])
}

enum InventoryMutationType {
  SALES_OUT
  STOCK_IN
  STOCK_ADJUSTMENT
}

model InventoryMutationEvent {
  id_queue         String                @id
  id_transaksi     String
  id_produk        String
  id_user          String
  jenis_mutasi     InventoryMutationType
  delta_qty        Int
  logical_clock    Int
  client_timestamp DateTime
  createdAt        DateTime              @default(now())

  @@index([id_produk, client_timestamp])
  @@index([id_user, client_timestamp])
}
